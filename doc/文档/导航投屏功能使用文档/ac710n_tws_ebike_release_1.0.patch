+#include "system/includes.h"
+#include "app_config.h"
+#include "uart_manager.h"
+#include "serial_packager.h"
+#include "serial_unpackager.h"
+
+#if INSTR_DEV_UART_ENABLE
+
+#define LOG_TAG         "[UART_MANAGER]"
+#define LOG_ERROR_ENABLE
+#define LOG_DEBUG_ENABLE
+#define LOG_INFO_ENABLE
+#define LOG_DUMP_ENABL
+#define LOG_ERROR_ENABLE
+#include "debug.h"
+
+/**
+ * @description: uart 发送cmd接口  
+ * @param {u8} cmd：命令号
+ * @param {u8} *data：数据
+ * @param {u32} len：数据长度
+ * @return {void}
+ */
+void uart_send_cmd_deal(u8 cmd, u8 *data, u32 len) 
+{
+    printf("uart_send_cmd_deal---cmd:%d", cmd);
+    instr_send_cmd(cmd, data, len);
+}
+
+void uart_send_cmd_no_res_deal(u8 cmd, u8 *data, u32 len) 
+{
+    printf("uart_send_cmd_no_res_deal---cmd:%d", cmd);
+    instr_send_cmd_no_rsp(cmd, data, len);
+}
+
+/**
+ * @description: 响应data接口  
+ * @param {void} 
+ * @return {void}
+ */
+static void uart_send_data_deal(u8 cmd, u8 *data, u32 len)
+{
+    printf("uart_response_data_deal");
+    instr_send_dat_cmd(cmd, data, len);
+}
+
+/**
+ * @description: 响应cmd接口  
+ * @param {void} 
+ * @return {void}
+ */
+static void uart_response_cmd_deal(u8 sn, u8 op_code, u8 status,  u8 *data, u32 len)
+{
+    printf("uart_response_cmd_deal");
+    // size_t construct_serial_cmd_request(uint8_t sn, bt_cmd_type_t rsp_flag, uint8_t op_code, uint8_t *buffer, uint32_t buffer_len) 
+    construct_serial_cmd_response(sn, RSP_CMD_TYPE_RSP, op_code, status, data, len);
+
+}
+
+/**
+ * @description: 响应data包接口  
+ * @param {void} 
+ * @return {void}
+ */
+static void uart_response_data_deal(u8 *data, u32 len)
+{
+    printf("uart_response_data_deal");
+
+}
+
+/**
+ * @description: 串口初始化接口  
+ * @param {void} 
+ * @return {void}
+ */
+static void uart_dev_init(void)
+{
+    printf("uart dev init");
+    uart_driver_init();
+}
+
+custom_uart_api_t custom_uart_api = {
+    .custom_uart_dev_init               = uart_dev_init,
+    .custom_uart_send_cmd_handle        = uart_send_cmd_deal,       //发送命令包格式处理
+    .custom_uart_send_cmd_no_rsp_handle = uart_send_cmd_no_res_deal,
+    .custom_uart_send_data_handle       = uart_send_data_deal,      //发送数据包处理
+    .custom_uart_response_cmd_handle    = uart_response_cmd_deal,   //接收命令包回复处理
+    .custom_uart_response_data_handle   = uart_response_data_deal,  //接收数据包回复处理
+};
+
+int instr_uart_test(void)
+{   
+    log_info("instr_uart_test\n");
+    if (INTSR_TASK_UART_API) {
+        INTSR_TASK_UART_API->custom_uart_dev_init();
+    }
+}
+// late_initcall(instr_uart_test);
+
+#endif
