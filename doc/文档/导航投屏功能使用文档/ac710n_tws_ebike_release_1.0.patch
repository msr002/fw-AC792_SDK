+    
+    // 填充包头固定部分
+    send_buffer[offset++] = packet->header[0]; // 包头字节1
+    send_buffer[offset++] = packet->header[1]; // 包头字节2
+    send_buffer[offset++] = packet->header[2]; // 包头字节3
+    send_buffer[offset++] = packet->type;      // 命令类型
+    
+    // SN码
+    send_buffer[offset++] = packet->sn;        
+    
+    // CRC位置先填充0，后面计算后再更新
+    send_buffer[offset++] = 0x00; // CRC高字节（暂存）
