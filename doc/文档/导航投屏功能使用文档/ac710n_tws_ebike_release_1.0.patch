+/**
+ * @brief 上报蓝牙连接状态
+ * @param status 连接状态
+ * @return int 操作结果
+ */
+int ebike_if_bt_connect_status(u8 status)
+{
+    log_debug("%s[line:%d, status:%d]\n", __func__, __LINE__, status);
+
+    // 创建状态数据包
+    u16 send_package_len = 2;
+    u8 *send_package = (u8 *)malloc(send_package_len);
+    if (send_package == NULL) {
+        log_error("Memory allocation failed in %s", __func__);
+        return -1;
+    }
+    
+    send_package[0] = PROTOCOL_TAG_SEND_BT_STATUS;
+    send_package[1] = status;
+
+    // 通过UART发送状态信息
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_CONCTRL, send_package, send_package_len);
+    free(send_package);
+    return 0;
+}
