+/*
+ * @brief 串口发送命令函数
+ * @param packet 命令包头指针
+ * @param buf 数据缓冲区指针
+ * @return 无
+ */
+static void serial_send_cmd(cmd_send_header_t *packet, u8 *buf) 
+{
+    // 检查输入参数有效性
+    if (packet == NULL) {
+        log_info("cdm pack err!!!\n");
+        return;
+    }
+    
+    if (buf == NULL && packet->len > 0) {
+        log_info("buf is null but len > 0!!!\n");
+        return;
+    }
+
+    #define FIXED_LEN   10  // 固定包头长度
+    
+    // 计算总数据长度：固定包头 + 数据长度
+    uint16_t total_len = FIXED_LEN + packet->len;
+    
+    // 动态分配发送缓冲区内存
+    uint8_t *send_buffer = (uint8_t *)malloc(total_len);
+    if (send_buffer == NULL) {
+        log_info("send buf malloc err!!!\n");
+        return; // 内存分配失败
+    }
+    
+    uint16_t offset = 0;  // 缓冲区偏移量
+    
+    // 填充包头固定部分
+    send_buffer[offset++] = packet->header[0]; // 包头字节1: 0xFE
+    send_buffer[offset++] = packet->header[1]; // 包头字节2: 0x55
+    send_buffer[offset++] = packet->header[2]; // 包头字节3: 0xAA
+    send_buffer[offset++] = packet->type;      // 命令类型
+    
+    // SN码
+    send_buffer[offset++] = packet->sn;        
+    
+    // CRC位置先填充0，后面计算后再更新
+    send_buffer[offset++] = 0x00; // CRC高字节（暂存）
+    send_buffer[offset++] = 0x00; // CRC低字节（暂存）
+    
+    int crc_data_pos = offset;  // 记录CRC计算起始位置
+    send_buffer[offset++] = packet->code; // 命令码
+    
+    // 数据长度（小端序）
+    send_buffer[offset++] = packet->len & 0xFF;        // 长度低字节
+    send_buffer[offset++] = (packet->len >> 8) & 0xFF; // 长度高字节
+    
+    // 填充数据载荷
+    if (buf != NULL && packet->len > 0) {
+        memcpy(&send_buffer[offset], buf, packet->len);
+        offset += packet->len;
+    }
+    
+    // 计算CRC范围（从OpCode字段开始到数据结束）
+    uint16_t crc_data_length = 1 + 2 + packet->len;
+    uint16_t crc = calculate_crc(&send_buffer[crc_data_pos], crc_data_length, 0);
+    
+    // 更新CRC到缓冲区
+    send_buffer[5] = crc & 0xFF;        // CRC低字节
+    send_buffer[6] = (crc >> 8) & 0xFF; // CRC高字节
+    
+    // 发送数据
+    uart_dev_write(send_buffer, total_len);
+    
+    // 释放缓冲区内存
+    free(send_buffer);
+}
