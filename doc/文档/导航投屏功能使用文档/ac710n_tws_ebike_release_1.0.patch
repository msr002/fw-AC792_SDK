+/*
+ * @brief CRC计算函数
+ * @param ptr 数据指针
+ * @param len 数据长度
+ * @param init CRC初始值
+ * @return 计算得到的CRC值
+ * @note 使用CRC16-XMODEM算法，需要根据实际协议进行调整
+ */
+uint16_t calculate_crc(const uint8_t *ptr, size_t len, u16 init) 
+{
+    // log_debug("%s weak func", __func__);
+    u16 poly = 0x1021;  // CRC16-XMODEM多项式
+    u16 crc = init;      // CRC初始值
+    
+    // 逐字节计算CRC
+    while(len--){
+        u16 data = *ptr++;  // 获取当前字节数据
+        
+        crc ^= data << 8;   // 逆序处理
+        
+        // 逐位计算CRC
+        for (u8 i = 0; i < 8; ++i){
+            crc = crc & 0x8000 ? (crc << 1) ^ poly : crc << 1;  // 逆序处理
+        }
+    }
+    
+    return crc;  // 返回计算得到的CRC值
+}
