+typedef enum {
+    BT_DATA_TYPE_REQUEST_WITHOUT_RSP  = 0x80, // 10000000 - 数据命令请求命令（不需要回复）
+    BT_DATA_TYPE_REQUEST_WITH_RSP     = 0xA0, // 10100000 - 数据命令请求命令（需要回复）
+    BT_DATA_TYPE_RESPONSE             = 0x0C0  // 11000000 - 数据命令回复
+} bt_data_type_t;
+
+
+// 命令协议包头结构体
+#pragma pack(1)
+typedef struct {
+    uint8_t header[3];    // FE 55 AA
+    uint8_t type;         // 命令类型
+    uint8_t sn;          // 序列号
+    uint16_t crc;         // CRC校验
+    uint8_t code;         // 命令码
+    uint16_t len;         // 长度（payload）
+    u8 *data;             // 有效数据
+} cmd_send_header_t;
+
+// 命令协议包回复头结构体
+typedef struct {
+    uint8_t header[3];    // FE 55 AA
+    uint8_t type;         // 命令类型
+    uint8_t sn;          // 序列号
+    uint16_t crc;         // CRC校验
+    uint8_t code;         // 命令码
+    uint16_t len;         // 长度（status + payload）
+    uint8_t cmd_status;   // 命令状态
+    u8 *data;             // 有效数据
+} cmd_response_header_t;
+
+// 数据包协议包头结构体
+typedef struct {
+    uint8_t header[3];    // FE 55 AA
+    uint8_t type;         // 命令类型
+    uint8_t sn;          // 序列号
+    uint16_t crc;         // CRC校验
+    uint8_t code;         // 命令码
+    uint16_t len;         // 长度（respon_code + payload）
+    uint8_t respon_code;  // 被响应的命令号
+    u8 *data;             // 有效数据
+} data_send_header_t;
+
+// 数据包协议包回复头结构体
+typedef struct {
+    uint8_t header[3];    // FE 55 AA
+    uint8_t type;         // 命令类型
+    uint8_t sn;          // 序列号
+    uint16_t crc;         // CRC校验
+    uint8_t code;         // 命令码
+    uint16_t len;         // 长度（cmd_status + respon_code + payload）
+    uint8_t cmd_status;   // 命令状态
+    uint8_t respon_code;  // 被响应的命令号
+    u8 *data;             // 有效数据
+} data_response_header_t;
+#pragma pack()
+
+size_t construct_serial_cmd_request(uint8_t sn, bt_cmd_type_t rsp_flag, uint8_t op_code, uint8_t *buffer, uint32_t buffer_len);
+size_t construct_serial_cmd_response(uint8_t sn, bt_cmd_type_t rsp_flag, uint8_t op_code, u8 status, uint8_t *buffer, uint32_t buffer_len);
+
+/**
+ * @brief UART 数据传输包解析错误码枚举
+ * @description 用于标识 UART 数据接收和解码过程中的各类错误状态
+ */
+typedef enum {
+    UART_ERR_SUCCESS      = 0x00, ///< 成功：操作顺利完成
+    UART_ERR_FAILED       = 0x01, ///< 失败：通用错误代码，表示未指明的操作失败
+    UART_ERR_UNDEFINED    = 0x02, ///< 未定义：遇到了未定义或未知的错误状态
+    UART_ERR_BUSY         = 0x03, ///< 忙碌状态：设备或资源正忙，无法立即响应请求
+    UART_ERR_NO_RESPONSE  = 0x04, ///< 没有收到回复：预期中的响应或确认信号未收到
+    UART_ERR_CRC          = 0x05, ///< CRC出错：整个数据包的循环冗余校验失败
+    UART_ERR_DATA_CRC     = 0x06, ///< 数据CRC出错：数据字段部分的CRC校验失败
+    UART_ERR_PARAM_OVERFLOW = 0x07, ///< 参数溢出：接收到的参数值超出允许范围
+    UART_ERR_DATA_OVERFLOW = 0x08, ///< 数据溢出：数据量超出缓冲区或预期长度（可能与ORE相关）[6](@ref)
+    UART_ERR_LRC          = 0x09,  ///< LRC获取出错：纵向冗余校验 (LRC) 计算或验证失败
+    UART_ERR_LEN_ERROR     = 0x0A, ///< 超时：接收超时或发送超时
+    UART_ERR_DATA_NULL      = 0x0B, //
+    UART_ERR_EARLY_RSP      = 0xFF,
+} UART_ErrorCode;
+
+extern int instr_send_cmd(u8 op_cmd, u8 *data, u32 len);
+extern int instr_send_cmd_no_rsp(u8 op_cmd, u8 *data, u32 len);
+extern uint16_t calculate_crc(const uint8_t *ptr, size_t len, u16 init);
+
+
+
+#endif
