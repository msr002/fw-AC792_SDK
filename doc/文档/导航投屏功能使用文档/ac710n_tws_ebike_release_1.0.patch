+
+/*​
+ * @brief 验证协议头是否正确
+ * @param head 协议头数据指针
+ * @return 1-验证成功，0-验证失败
+ * @note 协议头格式应为: 0xFE, 0x55, 0xAA
+ */
+int verify_protocol_head(const uint8_t* head) 
+{
+    // 检查协议头三个字节是否符合预期值
+    return (head[0] == 0xFE && head[1] == 0x55 && head[2] == 0xAA);
+}
+
+/*​
+ * @brief 命令回复验证CRC是否正常
+ * @param raw_data 原始数据指针
+ * @param total_length 数据总长度
+ * @return 1-CRC校验成功，0-CRC校验失败
+ */
+int cmd_rsp_verify_crc(u8 *raw_data, size_t total_length)
+{
+    printf("cmd_rsp_verify_crc...\n");
+    
+    // 检查输入参数有效性
+    if (raw_data == NULL || total_length == 0) {
+        printf("Invalid raw_data or total_length parameters!\n");
+        return 0;
+    }
+    
+    const cmd_response_header_t* packet = (const cmd_response_header_t*)raw_data;
+
+    // 计算CRC校验数据的起始偏移量
+    int code_offset = offsetof(cmd_response_header_t, code);
+    printf("code_offset : %d\n", code_offset);
+    
+    // 计算CRC值（从code字段开始到数据结束）
+    uint16_t calculated_crc = calculate_crc(raw_data + code_offset, total_length - code_offset, 0);
+
+    // 从原始数据中提取接收到的CRC值
+    uint16_t received_crc = packet->crc; 
+
+    // 比较计算出的CRC和接收到的CRC
+    if (calculated_crc == received_crc) {
+        printf("CRC check succedd: calculated_crc=0x%04X, recv=0x%04X\n", calculated_crc, received_crc);
+        return 1; // 成功
+    } else {
+        printf("CRC check fail : calculated_crc=0x%04X, recv=0x%04X\n", calculated_crc, received_crc);
+        return 0; // 失败
+    }
+}
+
+/*​
+ * @brief 数据命令回复验证CRC是否正常
+ * @param raw_data 原始数据指针
+ * @param total_length 数据总长度
+ * @return 1-CRC校验成功，0-CRC校验失败
+ */
+int data_cmd_rsp_verify_crc(u8 *raw_data, size_t total_length)
+{
+    printf("data cmd_rsp_verify_crc...\n");
+
+    // 检查输入参数有效性
+    if (raw_data == NULL || total_length == 0) {
+        printf("Invalid raw_data or total_length parameters!\n");
+        return 0;
+    }
+    
+    put_buf(raw_data, total_length);
+    const data_response_header_t* packet = (const data_response_header_t*)raw_data;
+
+    // 计算CRC校验数据的起始偏移量
+    int code_offset = offsetof(data_response_header_t, code);
+    printf("code_offset : %d\n", code_offset);
+    
+    // 计算CRC值（从code字段开始到数据结束）
+    uint16_t calculated_crc = calculate_crc(raw_data + code_offset, total_length - code_offset, 0);
+
+    // 从原始数据中提取接收到的CRC值
+    uint16_t received_crc = packet->crc; 
+
+    // 比较计算出的CRC和接收到的CRC
+    if (calculated_crc == received_crc) {
+        printf("CRC校验成功: 计算值=0x%04X, 接收值=0x%04X\n", calculated_crc, received_crc);
+        return 1; // 成功
+    } else {
+        printf("CRC校验失败: 计算值=0x%04X, 接收值=0x%04X\n", calculated_crc, received_crc);
+        return 0; // 失败
+    }
+}
+
+/*​
+ * @brief 从小端格式读取16位数据
+ * @param buffer 数据缓冲区指针
+ * @return 读取的16位数据
+ */
+uint16_t h_little_endian_read_16(const uint8_t *buffer) {
+    // 小端格式：低字节在前，高字节在后
+    return (uint16_t)(buffer[0]) | ((uint16_t)(buffer[1]) << 8);
+}
+
+/*​
+ * @brief 从大端格式读取16位数据
+ * @param buffer 数据缓冲区指针
+ * @param offset 偏移量
+ * @return 读取的16位数据
+ */
+uint16_t h_read_big_endian_u16(const uint8_t *buffer, size_t offset) {
+    // 大端格式：高字节在前，低字节在后
+    return (uint16_t)(buffer[offset]) << 8 | (uint16_t)(buffer[offset + 1]);
+}
+
+/*​
+ * @brief 解析命令响应包处理函数
+ * @param raw_data 原始数据指针
+ * @param length 数据长度
+ * @return 无
+ */
+void parse_cmd_response_deal(const uint8_t* raw_data, int length) 
+{
+    u8 ret = UART_ERR_SUCCESS;
+    
+    printf("%s %d\n", __func__, __LINE__);
+    
+    // 检查输入参数有效性
+    if (raw_data == NULL || length == 0) {
+        printf("Invalid raw_data or length parameters!\n");
+        goto __parse_cmd_error;
+    }
+    
+    cmd_send_header_t* packet = (const cmd_send_header_t*)raw_data;
+    printf("cmd_send_header_t len : %d\n", sizeof(cmd_send_header_t));
+    
+    // 验证CRC校验
+    int crc_ok = cmd_rsp_verify_crc(raw_data, length);
+    if (crc_ok == 0) {
+        printf("verify crc fail!!!\n");
+        ret = UART_ERR_DATA_CRC;
+        goto __parse_cmd_error;
+    } 
+    
+    // 获取数据载荷指针
+    u8 *packet_data = raw_data + 10;
+    printf("%s %d packet->code : %d\n", __func__, __LINE__, packet->code);
+
+    // 根据操作码处理不同命令
+    switch(packet->code) {
+    case OP_CODE_BT_CONCTRL:  // 蓝牙控制回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_BT_CONCTRL:%d\n", packet_data[0]);
+        ret = bt_device_manager_cmd_deal(packet->sn, packet_data, packet->len);
+        break;
+
+    case OP_CODE_HFP_CALL_CONCTRL:  // HFP电话控制回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_HFP_CALL_CONCTRL:%d\n", packet_data[0]);
+        ret = bt_hfp_call_cmd_deal(packet->sn, packet_data, packet->len);
+        break;
+
+    case OP_CODE_BT_PABP:  // 电话簿访问协议回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d\n", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_BT_PABP:%d\n", packet_data[0]);
+        ret = bt_bt_pbap_cmd_deal(packet->sn, packet_data, packet->len);
+        break;
+
+    case OP_CODE_BT_MUSIC_ALBUM:  // 蓝牙音乐专辑回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_BT_MUSIC_ALBUM:%d\n", packet_data[0]);
+        ret = bt_bt_music_cmd_deal(packet->sn, packet_data, packet->len);
+        break;
+
+    case OP_CODE_BT_MCU_CONTROL:  // MCU控制回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_BT_MCU_CONTROL:%d\n", packet_data[0]);
+        ret = mcu_ctrl_cmd_deal(packet->sn, packet_data, packet->len);
+        break;
+
+    case OP_CODE_OTA_CONCTRL:  // OTA控制回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_OTA_CONCTRL:%d\n", packet_data[0]);
+        ret = cmd_dat_send_ota_pack(packet->sn, packet_data, packet->len);
+        break;
+        
+    default:  // 未知命令
+        printf("unknown cmd code : %d\n", packet->code);
+        ret = UART_ERR_UNDEFINED;
+        break;
+    }
+    
+__parse_cmd_error:
+    // 如果不是提前响应，发送响应处理结果
+    if(ret != UART_ERR_EARLY_RSP){
+        INTSR_TASK_UART_API->custom_uart_response_cmd_handle(packet->sn, packet->code, ret, NULL, 0);
+    }
+}
+
+/*​
+ * @brief 解析无响应命令处理函数
+ * @param raw_data 原始数据指针
+ * @param length 数据长度
+ * @return 无
+ */
+void parse_cmd_no_response_deal(const uint8_t* raw_data, int length) 
+{
+    u8 ret = UART_ERR_SUCCESS;
+    
+    printf("%s %d\n", __func__, __LINE__);
+    
+    // 检查输入参数有效性
+    if (raw_data == NULL || length == 0) {
+        printf("Invalid raw_data or length parameters!\n");
+        return;
+    }
+    
+    cmd_send_header_t* packet = (const cmd_send_header_t*)raw_data;
+    printf("cmd_send_header_t len : %d\n", sizeof(cmd_send_header_t));
+    
+    // 验证CRC校验
+    int crc_ok = cmd_rsp_verify_crc(raw_data, length);
+    if (crc_ok == 0) {
+        printf("verify crc fail!!!\n");
+        ret = UART_ERR_DATA_CRC;
+        goto __parse_cmd_error;
+    } 
+    
+    // 获取数据载荷指针
+    u8 *packet_data = raw_data + 10;
+    printf("%s %d packet->code : %d\n", __func__, __LINE__, packet->code);
+
+    // 根据操作码处理不同命令
+    switch(packet->code) {
+    case OP_CODE_OTA_CONCTRL:  // OTA控制回复
+        if(packet->len == 0){
+            printf("%s, error, len = %d", __func__, packet->len);
+            ret = UART_ERR_LEN_ERROR;
+            goto __parse_cmd_error;
+        }
+        printf("OP_CODE_OTA_CONCTRL:%d\n", packet_data[0]);
+        ret = cmd_dat_send_ota_pack(packet->sn, packet_data, packet->len);
+        break;
+        
+    default:  // 未知命令
+        printf("unknown cmd code : %d\n", packet->code);
+        ret = UART_ERR_UNDEFINED;
+        break;
+    }
+    
+__parse_cmd_error:
+    // 处理错误情况
+    if(ret != UART_ERR_SUCCESS){
+        printf("cmd_deal_error:%d", ret);
+        ASSERT(0);
+    }
+}
+
+/*​
+ * @brief 解析响应包命令处理函数
+ * @param raw_data 原始数据指针
+ * @param length 数据长度
+ * @return 无
+ */
+void parse_rsp_package_cmd_deal(const uint8_t* raw_data, int length) 
+{
+    printf("%s %d\n", __func__, __LINE__);
+    
+   int crc_ok = cmd_rsp_verify_crc(raw_data, length);
+    if (crc_ok == 0) {
+        printf("verify crc fail!!!\n");
+        return;
+    }
+    cmd_response_header_t* packet = (cmd_response_header_t*)malloc(sizeof(cmd_response_header_t));
+    if (packet == NULL) {
+        log_error("cmd_response_header_t malloc error\n");
+        return;
+    }
+    
+    printf("%s %d packet->code : %d\n", __func__, __LINE__, packet->code);
+
+    // 释放动态分配的内存
+    free(packet);
+}
+
+/*​
+ * @brief 解析数据命令回复包
+ * @param raw_data 原始数据指针
+ * @param length 数据长度
+ * @return 无
+ */
+void parse_dat_cmd_response_deal(const uint8_t* raw_data, int length) 
+{
+    printf("%s %d\n", __func__, __LINE__);
+    
+    // 检查输入参数有效性
+    if (raw_data == NULL || length == 0) {
+        printf("Invalid raw_data or length parameters!\n");
+        return;
+    }
+    
+    const data_response_header_t* packet = (const data_response_header_t*)raw_data;
+    printf("data_response_header_t len : %d\n", sizeof(data_response_header_t));
+
+    // 验证CRC校验
+    int crc_ok = data_cmd_rsp_verify_crc(raw_data, length);
+    if (crc_ok == 0) {
+        printf("verify crc fail!!!\n");
+        return;
+    }
+    
+    printf("%s %d packet->code : %d\n", __func__, __LINE__, packet->code);
+
+    // 根据操作码处理不同命令
+    switch(packet->code)  {
+    case OP_CODE_DAT_CMD_CONCTRL:  // 数据命令包回复
+        printf("packet->cmd_status:%d\n", packet->cmd_status);
+        if (packet->cmd_status != UART_ERR_SUCCESS || packet->len < 0) {
+            log_debug("bt phont rsp fail!!!\n");
+            break;
+        } 
+        // 这里可以添加具体的数据命令处理逻辑
+        break;
+    }
+}
+
+/*​
+ * @brief 数据包解析器读取函数
+ * @param data 数据指针
+ * @param length 数据长度
+ * @return 0-成功，-1-失败
+ */
+int pack_parserread(u8 *data, u32 length)
+{
+    u8 ret = UART_ERR_SUCCESS;
+    
+    // 检查输入参数有效性
+    if (data == NULL) {
+        printf("pack err\n");
+        ret = UART_ERR_DATA_NULL;
+        goto __pack_error;
+    }
+
+    // 验证协议头
+    if (!verify_protocol_head(data)) {
+        printf("无效的协议头: 0x%02X%02X%02X (期望: 0xFE55AA)\n", 
+               data[0], data[1], data[2]);
+        ret = UART_ERR_DATA_CRC;
+        goto __pack_error;
+    }
+
+    // 解析数据包类型字段
+    uint8_t type = data[3];
+    log_debug("type:0x%x", type);
+    
+    // 根据数据类型进行相应处理
+    switch(type)
+    {
+    case RSP_CMD_TYPE_REQUEST:      // 命令响应类型
+        parse_cmd_response_deal(data, length);
+        break;
+    case RSP_DATA_TYPE_REQUEST:     // 数据响应类型
+        parse_dat_cmd_response_deal(data, length);
+        break;
+    case NO_RSP_CMD_TYPE_REQUEST:   // 无响应命令类型
+        parse_cmd_no_response_deal(data, length);
+        break;
+    case NO_RSP_DATA_TYPE_REQUEST:  // 无响应数据类型
+        break;
+    case RSP_CMD_TYPE_RSP:          // 命令响应回复类型
+        parse_rsp_package_cmd_deal(data, length);
+        break;
+    default:                        // 未知类型
+        log_debug("no need rsp!!!\n");
+        break;
+    }
+
+    return 0;
+    
+__pack_error:
+    // 错误处理：如果是命令请求类型，发送错误响应
+    if(data[4] == RSP_CMD_TYPE_REQUEST){
+        INTSR_TASK_UART_API->custom_uart_response_cmd_handle(0, 0, ret, NULL, 0);
+    }
+    return -1;
+}
+
+#endif
