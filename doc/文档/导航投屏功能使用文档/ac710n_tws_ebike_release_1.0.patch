diff --git a/SDK/apps/ebike/bt_device_manager.c b/SDK/apps/ebike/bt_device_manager.c
new file mode 100644
index 0000000..ffbc381
--- /dev/null
+++ b/SDK/apps/ebike/bt_device_manager.c
@@ -0,0 +1,583 @@
+#include "system/includes.h"
+#include "app_config.h"
+#include "bt_device_manager.h"
+#include "uart_manager.h"
+#include "serial_packager.h"
+#include "ebike_interface.h"
+#include "poweroff.h"
+
+#define LOG_TAG         "[BT_DEVICE_MANAGER]"
+#define LOG_ERROR_ENABLE
+#define LOG_DEBUG_ENABLE
+#define LOG_INFO_ENABLE
+#define LOG_DUMP_ENABL
+#define LOG_ERROR_ENABLE
+#include "debug.h"
+
+#if INSTR_DEV_UART_ENABLE
+
+/*​
+ * @brief 蓝牙开关控制函数[2](@ref)
+ * @param on 控制标志：0-关闭蓝牙，非0-开启蓝牙
+ * @return 无
+ */
+void bt_on_off_control(u8 on)
+{
+    printf("%s %d\n", __func__, __LINE__);
+
+    u8 data[2] = {0};
+
+    data[0] = PROTOCOL_TAG_SET_BT_ON_OFF;
+    if (!on) {
+        data[1] = BT_STATE_SET_OFF;
+    } else {
+        data[1] = BT_STATE_SET_ON;
+    }
+
+    // 检查UART API是否可用
+    if (INTSR_TASK_UART_API) {
+        // 经典蓝牙控制类下的蓝牙开关命令
+        INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_CONCTRL, data, 2); 
+    }
+}
+
+/*
+ * @brief 蓝牙名称设置函数[2](@ref)
+ * @param name 蓝牙名称字符串指针
+ * @param len 名称长度
+ * @return 无
+ */
+void bt_name_set_control(u8 *name, u32 len)
+{
+    printf("%s %d\n", __func__, __LINE__);
+
+    // 检查输入参数有效性[7,8](@ref)
+    if (name == NULL || len == 0) {
+        log_debug("Invalid name or length parameters!\n");
+        return;
+    }
+
+    // 动态分配内存[9,11](@ref)
+    u8 *data = (u8 *)malloc(len + 1);
+    if (data == NULL) {
+        log_debug("malloc data fail!!!\n");
+        return;
+    }
+
+    data[0] = PROTOCOL_TAG_SET_BT_NAME;
+    memcpy(&data[1], name, len);
+
+    if (INTSR_TASK_UART_API) {
+        INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_CONCTRL, data, len + 1); 
+    }
+
+    // 释放动态分配的内存[9](@ref)
+    free(data);
+}
+
+/*
+ * @brief 蓝牙MAC地址设置函数
+ * @param mac MAC地址数据指针
+ * @param len MAC地址长度
+ * @return 无
+ */
+void bt_mac_set_control(u8 *mac, u32 len)
+{
+    printf("%s %d\n", __func__, __LINE__);
+
+    // 检查输入参数有效性[7,8](@ref)
+    if (mac == NULL || len != 6) { // MAC地址通常为6字节
+        log_debug("Invalid MAC address or length parameters!\n");
+        return;
+    }
+
+    // 动态分配内存[9,11](@ref)
+    u8 *data = (u8 *)malloc(len + 1);
+    if (data == NULL) {
+        log_debug("malloc data fail!!!\n");
+        return;
+    }
+
+    data[0] = PROTOCOL_TAG_SET_BT_MAC;
+    memcpy(&data[1], mac, len);
+
+    if (INTSR_TASK_UART_API) {
+        INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_CONCTRL, data, len + 1); 
+    }
+
+    // 释放动态分配的内存[9](@ref)
+    free(data);
+}
+
+/*
+ * @brief 蓝牙设备管理命令处理函数[2](@ref)
+ * @param sn 序列号
