+/*​
+ * @brief 串口发送数据函数
+ * @param packet 数据包头指针
+ * @return 无
+ */
+static void serial_send_data(data_send_header_t *packet)
+{
+    // 检查输入参数有效性
+    if (packet == NULL) {
+        log_info("pack is null!!!\n");
+        return;
+    }
+    
+    if (packet->data == NULL && packet->len > 1) {
+        log_info("data is null but len > 1!!!\n");
+        return;
+    }
+
+    #define PROTOCOL_FIXED_HEADER_LEN   12  // 固定包头总长度
+    
+    // 计算数据长度：总长度减去响应码的1字节
+    uint16_t data_length = packet->len - 1;
+    uint16_t total_len = PROTOCOL_FIXED_HEADER_LEN + data_length;
+    
+    // 动态分配发送缓冲区内存
+    uint8_t *send_buffer = (uint8_t *)malloc(total_len);
+    if (send_buffer == NULL) {
+        log_info("send buf malloc err!!!\n");
+        return; // 内存分配失败
+    }
+    
+    uint16_t offset = 0;  // 缓冲区偏移量
+    
+    // 填充包头固定部分
+    send_buffer[offset++] = packet->header[0]; // 包头字节1
+    send_buffer[offset++] = packet->header[1]; // 包头字节2
+    send_buffer[offset++] = packet->header[2]; // 包头字节3
+    send_buffer[offset++] = packet->type;      // 数据类型
+    send_buffer[offset++] = (packet->sn >> 8) & 0xFF; // SN码高字节
+    send_buffer[offset++] = packet->sn & 0xFF;        // SN码低字节
+    send_buffer[offset++] = 0x00; // CRC高字节（暂存）
+    send_buffer[offset++] = 0x00; // CRC低字节（暂存）
+    
+    int crc_data_pos = offset;  // 记录CRC计算起始位置
+    send_buffer[offset++] = packet->code;    // 命令码
+    
+    // 数据长度（小端序）
+    send_buffer[offset++] = packet->len & 0xFF;        // 长度低字节
+    send_buffer[offset++] = (packet->len >> 8) & 0xFF; // 长度高字节
+    send_buffer[offset++] = packet->respon_code;       // 响应码
+    
+    // 填充数据载荷
+    if (packet->data != NULL && data_length > 0) {
+        memcpy(&send_buffer[offset], packet->data, data_length);
+        offset += data_length;
+    }
+    
+    // 计算CRC范围（从命令码字段开始到数据结束）
+    uint16_t crc_data_length = 1 + 2 + packet->len;
+    uint16_t crc = calculate_crc(&send_buffer[crc_data_pos], crc_data_length, 0);
+    
+    // 更新CRC到缓冲区
+    send_buffer[6] = crc & 0xFF;        // CRC低字节
+    send_buffer[7] = (crc >> 8) & 0xFF; // CRC高字节
+    
+    // 发送数据
+    uart_dev_write(send_buffer, total_len);
+    
+    // 释放缓冲区内存
+    free(send_buffer);
+}
