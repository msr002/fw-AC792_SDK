+/**
+ * @brief 设置蓝牙MAC地址
+ * @param addr MAC地址数组
+ * @param len 地址长度(必须为6)
+ * @return UART_ErrorCode 操作结果状态码
+ */
+UART_ErrorCode ebike_if_set_br_mac_addr(u8 *addr, u8 len)
+{
+    // 参数校验
+    if(len != 6){
+        return UART_ERR_PARAM_OVERFLOW;
+
+    }
+    
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    UART_ErrorCode ret = UART_ERR_SUCCESS;
+    
+    // 验证MAC地址长度
+    if(len != 6){
+        ret = UART_ERR_FAILED;
+        return ret;
+    }
+    
+    log_info("new mac:\n");
+    put_buf(addr, 6);
+    
+    // 如果TWS已连接手机，先断开连接
+    if(tws_api_get_tws_state() & TWS_STA_PHONE_CONNECTED){
+        bt_cmd_prepare(USER_CTRL_DISCONNECTION_HCI, 0, NULL);
+        os_time_dly(10);
+    }
+    
+    // 禁用蓝牙功能
+    bt_cmd_prepare(USER_CTRL_WRITE_SCAN_DISABLE, 0, NULL);
+    bt_cmd_prepare(USER_CTRL_WRITE_CONN_DISABLE, 0, NULL);
+    bt_cmd_prepare(USER_CTRL_PAGE_CANCEL, 0, NULL);
+    bt_cmd_prepare(USER_CTRL_CONNECTION_CANCEL, 0, NULL);
+    
+    // 更新MAC地址
+    bt_update_mac_addr(addr);
+    lmp_hci_write_local_address(addr);
+    syscfg_write(CFG_BT_MAC_ADDR, addr, 6);
+    
+    // 清除远程设备信息
+    bt_cmd_prepare(USER_CTRL_DEL_ALL_REMOTE_INFO, 0, NULL);
+    os_time_dly(1);
+    
+    // 重新启用蓝牙功能
+    bt_cmd_prepare(USER_CTRL_WRITE_SCAN_ENABLE, 0, NULL);
+    bt_cmd_prepare(USER_CTRL_WRITE_CONN_ENABLE, 0, NULL);
+
+    return ret ? UART_ERR_FAILED : UART_ERR_SUCCESS;
+}
