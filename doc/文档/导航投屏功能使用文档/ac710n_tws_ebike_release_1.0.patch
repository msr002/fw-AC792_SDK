+#ifndef _SERIAL_UNPACKAGER_H_
+#define _SERIAL_UNPACKAGER_H_
+
+#include "system/includes.h"
+int pack_parserread(u8 *data, u32 length);
+
+typedef enum {
+    NO_RSP_CMD_TYPE_REQUEST  = 0x00,    //0000 0000 命令包请求，不需要回复
+    RSP_CMD_TYPE_REQUEST  = 0x20,       //0010 0000 命令包请求，需要回复
+    RSP_CMD_TYPE_RSP  = 0x40,       //0100 0000 命令包回复，不需要回复
+    NO_RSP_DATA_TYPE_REQUEST = 0xC0,     //1100 0000 数据命令包，不需要回复
+    RSP_DATA_TYPE_REQUEST = 0x80,       //1010 0000 数据命令包，需要回复
+} response_type_t;
+
+#endif
