+    send_package[1] = (status >> 0) & 0xFF;  // 最低位字节（LSB）
+    send_package[2] = (status >> 8) & 0xFF;
+    send_package[3] = (status >> 16) & 0xFF;
+    send_package[4] = (status >> 24) & 0xFF; // 最高位字节（MSB）
+
+    // 将flag按照小端序写入数组
+    send_package[1] = (flag >> 0) & 0xFF;  // 最低位字节（LSB）
+    send_package[2] = (flag >> 8) & 0xFF;
+    send_package[3] = (flag >> 16) & 0xFF;
+    send_package[4] = (flag >> 24) & 0xFF; // 最高位字节（MSB）
+
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_MUSIC_ALBUM, send_package, send_package_len);
+    free(send_package);
 }
