+ * @return UART_ErrorCode 操作结果状态码
+ * @retval UART_ERR_SUCCESS 操作成功
+ * @retval UART_ERR_FAILED 操作失败
+ */
+UART_ErrorCode ebike_if_bt_close_bredr(void)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    UART_ErrorCode ret = 0;
+    
+    // 检查蓝牙是否已经关闭
+    if(!ebike_if_get_bt_is_open()){
+        log_info("bt is close\n");
+        return UART_ERR_SUCCESS;
+    }
+
+    // 切换到空闲模式以关闭蓝牙
+    ret = app_task_switch_to(APP_MODE_IDLE, NULL_VALUE);
+    if(ret){
+        log_error("%s err:%d\n", __func__, ret);
+    }
+
+    return ret ? UART_ERR_FAILED : UART_ERR_SUCCESS;
+}
