+
+#define BIP_DATA_PACKET_SIZE  (512)
+enum{
+    BIP_DATA_TRANSFER_ERR_SUCCESS = 0,  //传输成功
+    BIP_DATA_TRANSFER_ERR_BUF_FULL, //数据缓存区已满
+    BIP_DATA_TRANSFER_ERR_PHONE,    //手机返回错误
+};
+
+
+typedef struct __bip_data_info
+{
+    u16 bip_totle_len;
+    u16 bip_send_len;
+    u16 bip_recv_len;
+    u16 bip_send_crc;
+} bip_data_info;
+
+static bip_data_info bip_data_if ={
+    .bip_totle_len = 0,
+    .bip_send_len = 0,
+    .bip_recv_len = 0,
+    .bip_send_crc = 0,
+};
+
+void bip_data_send_data(u8 *data, u16 len)
+{
+    // 参数检查
+    if (data == NULL || len == 0) {
+        printf("Invalid parameters: data=%p, len=%u\n", (void*)data, len);
+        return;
+    }
+
+    // 预分配发送缓冲区（循环外分配一次）
+    const u16 send_package_len = BIP_DATA_PACKET_SIZE + 1;
+    u8 *send_package = (u8 *)malloc(send_package_len);
+    if (send_package == NULL) {
+        printf("Failed to allocate send buffer!\n");
+        return;
+    }
+
+    u32 remaining_len = len;
+    u32 tx_len = 0;
+    const u8 *p_offset = data; // 使用const指针指向源数据
+
+    printf("bip_data_send_data started, total len: %u\n", len);
+
+    // 主数据发送循环
+    while (remaining_len > 0) {
+        clr_wdt(); // 看门狗清零
+
+        // 计算本次发送长度
+        tx_len = (remaining_len > BIP_DATA_PACKET_SIZE) ? BIP_DATA_PACKET_SIZE : remaining_len;
+
+        // 构造数据包
+        send_package[0] = PROTOCOL_TAG_BT_ALBUM_TRANSFER_DATA;
+        memcpy(send_package + 1, p_offset, tx_len); // 直接拷贝源数据
+
+        // 发送数据包
+        INTSR_TASK_UART_API->custom_uart_send_cmd_no_rsp_handle(
+            OP_CODE_BT_MUSIC_ALBUM, send_package, tx_len + 1);
+
+        // 更新状态和CRC
+        bip_data_if.bip_send_len += tx_len;
+        bip_data_if.bip_send_crc = calculate_crc(p_offset, tx_len, bip_data_if.bip_send_crc); // 直接从源数据计算CRC
+        p_offset += tx_len;
+        remaining_len -= tx_len;
+    }
+
+    // 所有数据发送完成后，发送结束包
+    if (bip_data_if.bip_send_len == bip_data_if.bip_totle_len) {
+        printf("bip send end %u, crc:%u\n", bip_data_if.bip_totle_len, bip_data_if.bip_send_crc);
+
+        // 结束包长度固定，使用栈数组避免动态分配
+        send_package[0] = PROTOCOL_TAG_BT_ALBUM_TRANSFER_DATA_END;
+        send_package[1] = (bip_data_if.bip_send_crc >> 0) & 0xFF;  // LSB
+        send_package[2] = (bip_data_if.bip_send_crc >> 8) & 0xFF;  // MSB
+
+        INTSR_TASK_UART_API->custom_uart_send_cmd_handle(
+            OP_CODE_BT_MUSIC_ALBUM, send_package, 3);
+
+    } 
+    // else {
+    //     printf("Error: Sent length mismatch! Expected: %u, Actual: %u\n", len, total_sent);
+    // }
+
+    // 释放缓冲区
+    free(send_package);
+}
