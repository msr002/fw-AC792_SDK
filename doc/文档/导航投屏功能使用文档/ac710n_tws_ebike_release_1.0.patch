+/*
+ * @Description: 
+ * @Author: HJY
+ * @Date: 2025-09-22 10:24:19
+ * @LastEditTime: 2025-09-23 11:46:27
+ * @LastEditors: HJY
+ */
+/*
+ * @file dual_update_demo.h
+ * @brief 双系统OTA升级模块头文件
+ * @version 1.0.0
+ * @date 2023-12-07
+ * 
+ * @copyright Copyright (c) 2023, Your Company Name
+ * 
+ * 本文件定义了双系统OTA升级相关的数据结构、枚举类型和函数接口。
+ * 主要用于管理蓝牙设备的固件升级流程，包括升级状态通知、步骤控制和数据传递。
+ */
+
+#ifndef __DUAL_UPDATE_DEMO_H
+#define __DUAL_UPDATE_DEMO_H
+
+#include "system/includes.h"
+#include "serial_packager.h"
+
+/*
+ * @enum OTA升级通知状态码
+ * @brief 定义OTA升级过程中的各种通知状态
+ */
+enum{
+    DUAL_OTA_NOTIFY_SUCCESS = 0,  // OTA升级成功 
+    DUAL_OTA_NOTIFY_FAIL,         // OTA升级失败 
+    DUAL_OTA_NOTIFY_CONTINUE,     // OTA升级继续 
+    DUAL_OTA_NOTIFY_EXIT,         // OTA升级退出
+    DUAL_OTA_NOTIFY_UNINIT,       // OTA升级未初始化
+};
+
+/*
+ * @enum DUAL_OTA_STEP
+ * @brief 定义OTA升级的步骤枚举
+ */
+typedef enum{
+    DUAL_OTA_STEP_START = 0,  //TA升级开始步骤
+    DUAL_OTA_STEP_WRITE,      //OTA数据写入步骤 
+    DUAL_OTA_STEP_VERIFY,     //OTA数据验证步骤 
+}DUAL_OTA_STEP;
+
+/*
+ * @struct dual_ota_info
+ * @brief OTA升级文件信息结构体
+ * 
+ * 该结构体用于存储OTA升级文件的相关信息，
+ * 包括文件大小、CRC校验值和最大数据包长度。
+ */
+typedef struct {
+    u32 file_size;     //升级文件大小(单位:字节)，对应db_update_data.bin文件 
+    u32 file_crc;      //文件CRC校验值，使用CRC_TYPE对应的算法计算 
+    u32 max_pkt_len;   //最大数据包长度，对应MAX_PACKET_LEN 
+}dual_ota_info;
+
+/*
+ * @brief 处理OTA升级请求
+ * @param[in] step OTA升级步骤，参见DUAL_OTA_STEP枚举
+ * @param[in] buf 数据缓冲区指针
+ * @param[in] len 数据长度
+ * @return UART_ErrorCode 处理结果错误码
+ * 
+ * @note 该函数根据不同的升级步骤执行相应的处理操作
+ * @warning 缓冲区指针必须有效，长度不能为0
+ */
+extern UART_ErrorCode dual_ota_update_deal(u8 step, u8 *buf, u32 len);
+
+/*
+ * @brief 接收OTA二进制数据
+ * @param[in] buf 二进制数据缓冲区指针
+ * @param[in] len 数据长度
+ * @return UART_ErrorCode 处理结果错误码
+ * 
+ * @note 该函数用于接收和处理OTA升级的二进制数据块
+ */
+extern UART_ErrorCode dual_ota_receive_bin_data(u8 *buf, u32 len);
+
+/*
+ * @brief OTA无响应失败退出处理
+ * 
+ * @note 当OTA升级过程中出现无响应情况时，调用此函数进行清理和状态重置
+ * @warning 该函数不会返回任何错误码，调用后需要检查系统状态
+ */
+extern void dual_ota_no_rsp_fail_exit(void);
+
+#endif  //__DUAL_UPDATE_DEMO_H
