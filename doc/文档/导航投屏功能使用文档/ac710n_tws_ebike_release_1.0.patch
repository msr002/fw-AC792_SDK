+ */
+UART_ErrorCode ebike_if_mcu_shut_off(void)
+{
+    UART_ErrorCode ret = UART_ERR_SUCCESS;
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    
+    // 根据当前应用模式选择关机方式
+    if(app_in_mode(APP_MODE_BT)){
+        // 蓝牙模式下使用系统正常软关机
+        sys_enter_soft_poweroff(POWEROFF_NORMAL);
+    }else{
+        // 其他模式下使用空闲模式软关机
+        app_idle_enter_softoff();
+    }
+    
+    return ret ? UART_ERR_FAILED : UART_ERR_SUCCESS;
+}
