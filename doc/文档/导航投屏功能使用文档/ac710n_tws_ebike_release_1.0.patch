+/**
+ * @brief 获取电话本信息
+ * @return UART_ErrorCode 操作结果状态码
+ */
+UART_ErrorCode ebike_if_get_phonebook(void)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    UART_ErrorCode ret = UART_ERR_SUCCESS;
+    
+    // 检查蓝牙连接状态
+    if (!ebike_if_get_bt_is_open()) {
+        log_error("Bluetooth is not enabled\n");
+        return UART_ERR_FAILED;
+    }
+    
+    // 发送读取电话本命令
+    bt_cmd_prepare(USER_CTRL_PBAP_READ_ALL, 0, NULL);
+    
+    // 重置电话本计数
+    ebike_if.bt_pbap_book_cnt = 0;
+    ebike_if.bt_pbap_income_cnt = 0;
+    ebike_if.bt_pbap_miss_cnt = 0;
+    ebike_if.bt_pbap_outcome_cnt = 0;
+    
+    return ret ? UART_ERR_FAILED : UART_ERR_SUCCESS;
+}
+
+#define PHONEBOOK_MAX_CNT 30          // 电话本最大条目数
+#define FIELD_SEPARATOR 0x1F          // 字段分隔符 (Unit Separator ASCII字符)
+
+/**
+ * @brief 电话本读取回调函数
+ * @param type 电话本类型 (0:电话本, 1:去电, 2:来电, 3:未接)
+ * @param name 联系人姓名
+ * @param number 电话号码
+ * @param date 日期信息
+ * @return int 处理结果
+ */
+int ebike_if_phonebook_read_cb(u8 type, const u8 *name, const u8 *number, const u8 *date)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+
+    
+    // 计算各字段长度
+    u16 name_len = (name != NULL) ? strlen((char*)name)+1 : 0;
+    u16 number_len = (number != NULL) ? strlen((char*)number)+1 : 0;
+    u16 date_len = (date != NULL) ? strlen((char*)date)+1 : 0;
+    
+    // 计算数据包总长度 = 固定字段 + 变长字段 + 分隔符
+    u16 send_package_len = 2 + 3 + name_len + number_len + date_len +1;
+    u8 *send_package = (u8 *)malloc(send_package_len);
+    if(send_package == NULL){
+        log_error("Memory allocation failed\n");
+        return -1;
+    }
+    
+    
+    u8 *ptr = send_package;
+    
+    // 预留命令字段位置
+    ptr++;
+    
+    // 预留序列号位置
+    ptr++;
+    
+    // 类型字段
+    *ptr++ = type;
+    
+    // 第一个分隔符
+    *ptr++ = FIELD_SEPARATOR;
+    
+    // 姓名字段
+    if(name_len > 0) {
+        memcpy(ptr, name, name_len);
+
+        ptr += name_len;
+    }
+    
+    // 第二个分隔符
+    *ptr++ = FIELD_SEPARATOR;
+    
+    // 号码字段
+    if(number_len > 0) {
+        memcpy(ptr, number, number_len);
+        ptr += number_len;
+    }
+    
+    // 第三个分隔符
+    *ptr++ = FIELD_SEPARATOR;
+    
+    // 日期字段
+    if(date_len > 0) {
+        memcpy(ptr, date, date_len);
+        ptr += date_len;
+    }
+    // printf("111112\n");
+    // put_buf(name, name_len);
+    // printf("111113\n");
+    // put_buf(number, number_len);
+    // printf("111114\n");
+    // put_buf(date, date_len);
+    // printf("name_len:%d, number_len:%d, date_len:%d:\n", name_len, number_len, date_len);
+    put_buf(send_package, send_package_len);
+            
+    // 根据不同类型处理电话本数据
+    switch (type)
+    {
+    case 0: // 电话本
+        ebike_if.bt_pbap_book_cnt++;
+        if(ebike_if.bt_pbap_book_cnt <= PHONEBOOK_MAX_CNT){
+            send_package[0] = PROTOCOL_TAG_BT_PBAP_LIST_READ_RESP;
+            send_package[1] = ebike_if.bt_pbap_book_cnt;
+            INTSR_TASK_UART_API->custom_uart_send_cmd_no_rsp_handle(OP_CODE_BT_PABP, send_package, send_package_len);
+        }
+        break;
+
+    case 1: // 去电记录
+        ebike_if.bt_pbap_outcome_cnt++;
+        if(ebike_if.bt_pbap_outcome_cnt <= PHONEBOOK_MAX_CNT){
+            send_package[0] = PROTOCOL_TAG_BT_PBAP_LIST_READ_RESP;
+            send_package[1] = ebike_if.bt_pbap_outcome_cnt;
+            INTSR_TASK_UART_API->custom_uart_send_cmd_no_rsp_handle(OP_CODE_BT_PABP, send_package, send_package_len);
+        }
+        break;
+
+    case 2: // 来电记录
+        ebike_if.bt_pbap_income_cnt++;
+        if(ebike_if.bt_pbap_income_cnt <= PHONEBOOK_MAX_CNT){
+            send_package[0] = PROTOCOL_TAG_BT_PBAP_LIST_READ_RESP;
+            send_package[1] = ebike_if.bt_pbap_income_cnt;
+            INTSR_TASK_UART_API->custom_uart_send_cmd_no_rsp_handle(OP_CODE_BT_PABP, send_package, send_package_len);
+        }
+        break;
+
+    case 3: // 未接记录
+        ebike_if.bt_pbap_miss_cnt++;
+        if(ebike_if.bt_pbap_miss_cnt <= PHONEBOOK_MAX_CNT){
+            send_package[0] = PROTOCOL_TAG_BT_PBAP_LIST_READ_RESP;
+            send_package[1] = ebike_if.bt_pbap_miss_cnt;
+            INTSR_TASK_UART_API->custom_uart_send_cmd_no_rsp_handle(OP_CODE_BT_PABP, send_package, send_package_len);
+        }
+        break;
+
+    case 0xff:
+        send_package_len = 1;
+        send_package[0] = PROTOCOL_TAG_BT_PBAP_LIST_READ_END;
+        INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_PABP, send_package, send_package_len);
+        break;
+
+
+    
+    default:
+        break;
+    }
+    
+    free(send_package);
+    return 0;
+}
+
+/**
+ * @brief 读取远程设备名称
+ * @param status 状态码
+ * @param addr 设备地址
+ * @param name 设备名称
+ * @return int 操作结果
+ */
+int ebike_if_read_remote_name(u8 status, u8 *addr, u8 *name)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    
+    // 创建远程名称数据包
+    u16 send_package_len = strlen(name) +1;
+    u8 *send_package = (u8 *)malloc(send_package_len);
+    if(send_package == NULL){
+        log_error("Memory allocation failed\n");
+        return -1;
+    }
+    send_package[0] = PROTOCOL_TAG_BT_GET_REMOTE_NAME;
+    memcpy(send_package + 1, name, send_package_len - 1);
+
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_CONCTRL, send_package, send_package_len);
+    free(send_package);
+    return 0;
+}
+
+/**
+ * @brief 请求蓝牙配对
+ * @param pin_code 配对PIN码
+ * @return int 操作结果
+ */
+int ebike_if_bt_req_pair(u32 pin_code)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    
+    // 创建配对请求数据包
+    u16 send_package_len = 5; // 1字节命令标识 + 4字节pin_code
+    u8 *send_package = (u8 *)malloc(send_package_len);
+    if (send_package == NULL) {
+        log_debug("Memory allocation failed");
+        return -1;
+    }
+    
+    // 命令标识
+    send_package[0] = PROTOCOL_TAG_BT_REQ_PAIR;
+    
+    // 将pin_code按照小端序写入数组
+    send_package[1] = (pin_code >> 0) & 0xFF;  // 最低位字节（LSB）
+    send_package[2] = (pin_code >> 8) & 0xFF;
+    send_package[3] = (pin_code >> 16) & 0xFF;
+    send_package[4] = (pin_code >> 24) & 0xFF; // 最高位字节（MSB）
+
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_BT_CONCTRL, send_package, send_package_len);
+    free(send_package);
+
+    return 0;
+}
+
+/**
+ * @brief 蓝牙配对响应
+ * @param pair 配对响应
+ * @return UART_ErrorCode 操作结果状态码
+ */
+UART_ErrorCode ebike_if_bt_req_pair_rsp(u8 pair)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    UART_ErrorCode ret = UART_ERR_SUCCESS;
+    
+    // 发送配对响应
+    if(pair){
+        bt_send_pair(1);
+    }else{
+        bt_send_pair(0);
+    }
+    
+    return ret ? UART_ERR_FAILED : UART_ERR_SUCCESS;
+}
