+/*​​
+ * @brief 发送OTA终止命令
+ * @param err 错误码，表示终止原因
+ * @return 0-成功，-1-内存分配失败
+ */
+int bt_ota_manager_ota_send_terminate(u8 err)
+{
+    log_debug("%s %d\n", __func__, __LINE__);
+    
+    // 准备发送数据包：协议标签 + 错误码
+    u16 send_package_len = 2;   
+    u8 *send_package = NULL;
+    
+    // 动态分配内存用于发送数据包
+    send_package = malloc(send_package_len);
+    if(!send_package){
+        log_error("%s malloc err\n", __func__);
+        return -1; // 内存分配失败，返回错误
+    }
+    
+    // 填充协议数据
+    send_package[0] = PROTOCOL_TAG_OTA_TERMINATE; // 协议标签：OTA终止
+    send_package[1] = err;                        // 错误码
+    
+    // 通过UART发送OTA控制命令
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_OTA_CONCTRL, send_package, send_package_len);
+    
+    // 释放动态分配的内存
+    free(send_package);
+    
+    return 0; // 成功返回
+}
+
+/*​​​
+ * @brief 发送OTA结束命令
+ * @param err 错误码，表示结束状态
+ * @return 0-成功，-1-内存分配失败
+ */
+int bt_ota_manager_ota_end(u8 err)
+{
+    log_debug("%s %d\n", __func__, __LINE__);
+    
+    // 准备发送数据包：协议标签 + 错误码
+    u16 send_package_len = 2;   
+    u8 *send_package = NULL;
+    
+    // 动态分配内存用于发送数据包
+    send_package = malloc(send_package_len);
+    if(!send_package){
+        log_error("%s malloc err\n", __func__);
+        return -1; // 内存分配失败，返回错误
+    }
+    
+    // 填充协议数据
+    send_package[0] = PROTOCOL_TAG_OTA_END; // 协议标签：OTA结束
+    send_package[1] = err;                  // 错误码
+    
+    // 通过UART发送OTA控制命令
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_OTA_CONCTRL, send_package, send_package_len);
+    
+    // 释放动态分配的内存
+    free(send_package);
+    
+    return 0; // 成功返回
+}
+
+/*​​
+ * @brief 通知可以发送OTA数据
+ * @return 0-成功，-1-内存分配失败
+ */
+int bt_ota_manager_can_send_data(void)
+{
+    log_debug("%s %d\n", __func__, __LINE__);
+    
+    // 准备发送数据包：仅包含协议标签
+    u16 send_package_len = 1;   
+    u8 *send_package = NULL;
+    
+    // 动态分配内存用于发送数据包
+    send_package = malloc(send_package_len);
+    if(!send_package){
+        log_error("%s malloc err\n", __func__);
+        return -1; // 内存分配失败，返回错误
+    }
+    
+    // 填充协议数据
+    send_package[0] = PROTOCOL_TAG_OTA_DATA_CAN_SEND; // 协议标签：可以发送数据
+    
+    // 通过UART发送OTA控制命令
+    INTSR_TASK_UART_API->custom_uart_send_cmd_handle(OP_CODE_OTA_CONCTRL, send_package, send_package_len);
+    
+    // 释放动态分配的内存
+    free(send_package);
+    
+    return 0; // 成功返回
+}
+
+/*​​
+ * @brief OTA数据包命令处理函数
+ * @param sn 序列号，用于响应匹配
+ * @param data 接收到的数据指针
+ * @param len 数据长度
+ * @return 处理结果错误码
+ */
+u8 cmd_dat_send_ota_pack(u8 sn, u8 *data, u16 len)
+{
+    printf("%s %d\n", __func__, __LINE__);
+    int ret = UART_ERR_SUCCESS;    // 默认返回成功
+    u16 rsp_package_len = 0;        // 响应包长度
+    u8 *rsp_package = NULL;         // 响应包指针
+
+    // 检查输入参数有效性
+    if (data == NULL || len == 0) {
+        printf("Invalid data or length parameters!\n");
+        return UART_ERR_LEN_ERROR;
+    }
+
+    // 根据协议标签处理不同命令
+    switch (data[0]) {
+    case PROTOCOL_TAG_OTA_START: // OTA开始命令
+        // 检查数据长度是否符合要求
+        if(len != 7){
+            printf("PROTOCOL_TAG_OTA_START len error\n");
+            ret = UART_ERR_FAILED;
+            break;
+        }
+        
+        // 处理OTA开始请求，传递除去协议标签后的数据
+        ret = dual_ota_update_deal(DUAL_OTA_STEP_START, &data[1], len - 1);
+        
+        // 准备响应数据包
+        rsp_package_len = 1;
+        rsp_package = malloc(rsp_package_len);
+        if (rsp_package == NULL) {
+            log_debug("malloc failed for response package!\n");
+            ret = UART_ERR_FAILED;
+            break;
+        }
+        
+        rsp_package[0] = PROTOCOL_TAG_OTA_START; // 响应协议标签
+        
+        // 发送响应命令
+        INTSR_TASK_UART_API->custom_uart_response_cmd_handle(sn, OP_CODE_OTA_CONCTRL, ret, rsp_package, rsp_package_len);
+        
+        free(rsp_package);    // 释放响应包内存
+        ret = UART_ERR_EARLY_RSP; // 表示已提前发送响应
+        break;
+
+    case PROTOCOL_TAG_OTA_DATA_TRANSFER: // OTA数据传输命令
+        // 检查数据长度是否超过最大限制
+        if(len > 513){
+            printf("PROTOCOL_TAG_OTA_DATA_TRANSFER len error\n");
+            ret = UART_ERR_FAILED;
+            break;
+        }
+        
+        // 接收并处理OTA二进制数据，传递除去协议标签后的数据
+        dual_ota_receive_bin_data(&data[1], len - 1);
+        break;
+
+    case PROTOCOL_TAG_OTA_DATA_TRANSFER_END: // OTA数据传输结束命令
+        // 准备响应数据包
+        rsp_package_len = 1;
+        rsp_package = malloc(rsp_package_len);
+        if (rsp_package == NULL) {
+            log_debug("malloc failed for response package!\n");
+            ret = UART_ERR_FAILED;
+            break;
+        }
+        
+        rsp_package[0] = PROTOCOL_TAG_OTA_DATA_TRANSFER_END; // 响应协议标签
+        
+        // 处理OTA传输结束
+        ret = dual_ota_receive_transfer_end();
+        
+        // 发送响应命令
+        INTSR_TASK_UART_API->custom_uart_response_cmd_handle(sn, OP_CODE_OTA_CONCTRL, ret, rsp_package, rsp_package_len);
+        
+        free(rsp_package);    // 释放响应包内存
+        ret = UART_ERR_EARLY_RSP; // 表示已提前发送响应
+        break;
+
+    case PROTOCOL_TAG_OTA_TERMINATE: // OTA终止命令
+        // 准备响应数据包
+        rsp_package_len = 1;
+        rsp_package = malloc(rsp_package_len);
+        if (rsp_package == NULL) {
+            log_debug("malloc failed for response package!\n");
+            ret = UART_ERR_FAILED;
+            break;
+        }
+        
+        // 注意：这里使用了PROTOCOL_TAG_OTA_DATA_TRANSFER_END，可能需要根据协议确认是否正确
+        rsp_package[0] = PROTOCOL_TAG_OTA_DATA_TRANSFER_END;
+        
+        // 处理无响应失败退出
+        dual_ota_no_rsp_fail_exit();
+        
+        // 发送响应命令
+        INTSR_TASK_UART_API->custom_uart_response_cmd_handle(sn, OP_CODE_OTA_CONCTRL, ret, rsp_package, rsp_package_len);
+        
+        free(rsp_package);    // 释放响应包内存
+        ret = UART_ERR_EARLY_RSP; // 表示已提前发送响应
+        break;
+
+    case PROTOCOL_TAG_OTA_GET_VERSION: // 获取版本信息命令
+        // 计算响应包长度：协议标签 + 版本字符串 + 结束符
+        rsp_package_len = strlen(ebike_vesion) + 2;
+        rsp_package = malloc(rsp_package_len);
+        if (rsp_package == NULL) {
+            log_debug("malloc failed for response package!\n");
+            ret = UART_ERR_FAILED;
+            break;
+        }
+        
+        rsp_package[0] = PROTOCOL_TAG_OTA_GET_VERSION; // 响应协议标签
+        // 复制版本字符串到响应包
+        memcpy(&rsp_package[1], ebike_vesion, strlen(ebike_vesion));
+        rsp_package[rsp_package_len-1] = '\0'; // 添加字符串结束符
+        
+        // 发送响应命令
+        INTSR_TASK_UART_API->custom_uart_response_cmd_handle(sn, OP_CODE_OTA_CONCTRL, ret, rsp_package, rsp_package_len);
+        
+        free(rsp_package);    // 释放响应包内存
+        ret = UART_ERR_EARLY_RSP; // 表示已提前发送响应
+        break;
+        
+    default: // 未知命令处理
+        printf("Unknown OTA command tag: 0x%02X\n", data[0]);
+        ret = UART_ERR_FAILED;
+        break;
+    }
+
+    return ret; // 返回处理结果
+}
+
+#endif
+
