+/**
+ * @brief 获取蓝牙MAC地址
+ * @return const u8* MAC地址指针(6字节)
+ */
+const u8 *ebike_if_get_br_mac_addr(void)
+{
+    log_debug("%s[line:%d]\n", __func__, __LINE__);
+    return bt_get_mac_addr();
+}
